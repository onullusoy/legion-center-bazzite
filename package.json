{
  "name": "legion-center",
  "version": "0.1.1-bazzite.6",
  "description": "Bazzite Edition of Legion Center with community-developed Legion Go controls",
  "type": "module",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover -s tests -v",
    "check": "pnpm test && tsc --noEmit && pnpm run build",
    "package": "bash scripts/package.sh"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "legion-go"
  ],
  "author": "Bazzite community contributors",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/lodash": "^4.14.202",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "shx": "^0.3.4",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@reduxjs/toolkit": "^1.9.7",
    "lodash": "^4.17.21",
    "react-icons": "^5.3.0",
    "react-redux": "^8.1.3",
    "redux": "^4.2.1",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "packageManager": "pnpm@8.15.1+sha1.8adba2d20330c02d3856e18c4eb3819d1d3ca6aa"
}
